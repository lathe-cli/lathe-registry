{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe-cli.github.io/lathe-registry/schema/index.schema.json",
  "title": "Lathe registry index",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "recipes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "display_name",
          "cli_name",
          "category",
          "description",
          "auth",
          "recipe_path",
          "readme_path",
          "skill_path",
          "build_path",
          "source_refs"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "cli_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "auth": {
            "type": "object"
          },
          "recipe_path": {
            "type": "string"
          },
          "readme_path": {
            "type": "string"
          },
          "catalog_path": {
            "type": "string"
          },
          "skill_path": {
            "type": "string"
          },
          "build_path": {
            "type": "string"
          },
          "artifacts": {
            "type": "array"
          },
          "source_refs": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
