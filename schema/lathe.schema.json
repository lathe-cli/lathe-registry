{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe-cli.github.io/lathe-registry/schema/lathe.schema.json",
  "title": "Lathe registry recipe metadata",
  "type": "object",
  "required": [
    "name",
    "display_name",
    "cli_name",
    "category",
    "description",
    "maintainers",
    "auth",
    "smoke"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "cli_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "github"
        ],
        "properties": {
          "github": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "type",
        "notes"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "bearer",
            "custom"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "smoke": {
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
