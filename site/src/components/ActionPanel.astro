---
import { sitePath } from "../lib/paths";

const { recipe } = Astro.props;
const cliArtifacts = recipe.artifacts.filter((artifact) => artifact.kind === "cli");
const defaultArtifact = cliArtifacts[0];
const recipeUrl = `https://github.com/lathe-cli/lathe-registry/tree/main/${recipe.recipe_path}`;
const gatePassed = recipe.gate?.verdict === "GO";
const buildCommand = `node scripts/gate.mjs --recipes ${recipe.name} --write`;
const artifactLabel = cliArtifacts.length > 0 ? `${cliArtifacts.length} platform builds` : "not built";

function targetLabel(artifact) {
  const os = { darwin: "macOS", linux: "Linux", windows: "Windows" }[artifact.os] ?? artifact.os;
  return `${os} / ${artifact.arch}`;
}
---

<aside class="action-panel">
  <div class="panel-head">
    <span class="panel-label">Recipe actions</span>
    <h2><code>{recipe.cli_name}</code></h2>
    <p>{recipe.auth.notes}</p>
  </div>

  {defaultArtifact && (
    <>
      <label class="artifact-picker select-control">
        <span class="panel-label">Platform</span>
        <select data-artifact-select>
          {cliArtifacts.map((artifact) => (
            <option value={sitePath(artifact.path)}>{targetLabel(artifact)}</option>
          ))}
        </select>
      </label>
      <a class="button primary block" href={sitePath(defaultArtifact.path)} download data-artifact-download>
        Download CLI (.tar.gz)
      </a>
    </>
  )}

  <button class:list={["button block", !defaultArtifact && "primary"]} type="button" data-copy-value={buildCommand}>
    {defaultArtifact ? "Copy build command" : "Build CLI locally"}
  </button>
  <a class="button ghost block" href={recipeUrl}>View recipe source</a>

  <div class="prompt-preview">
    <span class="panel-label">Local build</span>
    <code>{buildCommand}</code>
    <small>Writes <code>site/public/downloads/{recipe.cli_name}-&lt;os&gt;-&lt;arch&gt;.tar.gz</code></small>
  </div>

  <div class="artifact-list">
    <span class="panel-label">Current evidence</span>
    <p>
      <span>Gate</span>
      <code>{gatePassed ? "passed" : "not run"}</code>
    </p>
    <p>
      <span>CLI binary</span>
      <code>{artifactLabel}</code>
    </p>
    <p>
      <span>Skill</span>
      <code>{recipe.gate?.skill_included ? "included in CLI" : "not verified"}</code>
    </p>
    <p>
      <span>Build metadata</span>
      <code>{recipe.build_path}</code>
    </p>
  </div>

  <div class="source-list">
    <span class="panel-label">Pinned sources</span>
    {recipe.source_refs.map((source) => (
      <p>
        <strong>{source.display_name}</strong>
        <code>{source.pinned_tag}</code>
      </p>
    ))}
  </div>
</aside>

<script>
  const artifactSelect = document.querySelector<HTMLSelectElement>("[data-artifact-select]");
  const artifactDownload = document.querySelector<HTMLAnchorElement>("[data-artifact-download]");
  artifactSelect?.addEventListener("change", () => {
    artifactDownload?.setAttribute("href", artifactSelect.value);
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-value]")) {
    button.addEventListener("click", async () => {
      const value = button.dataset.copyValue ?? "";
      const label = button.textContent;

      try {
        if (!navigator.clipboard) throw new Error("clipboard unavailable");
        await navigator.clipboard.writeText(value);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Copy failed";
      }

      setTimeout(() => {
        button.textContent = label;
      }, 1600);
    });
  }
</script>
