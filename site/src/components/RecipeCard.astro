---
import { sitePath } from "../lib/paths";

const { recipe } = Astro.props;
const sourceCount = recipe.source_refs.length;
const skillReady = recipe.skill_path ? "Skill ready" : "Skill pending";
const sourceNames = recipe.source_refs.map((source) => source.display_name).join(" / ");
const sourceSearchNames = recipe.source_refs.map((source) => `${source.name} ${source.display_name}`).join(" ");
const smokeCommand = `${recipe.cli_name} search "${recipe.smoke.intent}" --json`;
const searchText = [
  recipe.display_name,
  recipe.name,
  recipe.cli_name,
  recipe.category,
  recipe.description,
  sourceNames,
  sourceSearchNames
].join(" ").toLowerCase();
---

<article class="recipe-tile" data-recipe-card data-search-text={searchText}>
  <div class="recipe-tile-head">
    <div class="recipe-tile-code">
      <code>{recipe.cli_name}</code>
    </div>
    <span class:list={["status-badge", recipe.skill_path && "verified"]}>{skillReady}</span>
  </div>

  <div class="recipe-tile-main">
    <strong>{recipe.display_name}</strong>
    <span>{recipe.description}</span>
  </div>

  <div class="recipe-tile-meta">
    <span>{recipe.category}</span>
    <span>{recipe.auth.type} auth</span>
    <span>{sourceCount} pinned</span>
  </div>

  <div class="recipe-tile-proof">
    <span>{sourceNames}</span>
    <code>{smokeCommand}</code>
  </div>

  <div class="recipe-tile-actions">
    <a class="button compact primary" href={sitePath(`cli/${recipe.name}/`)}>Details</a>
    {recipe.skill_path && <a class="button compact ghost" href={sitePath(`downloads/${recipe.name}-skill.tar.gz`)} download>Skill</a>}
  </div>
</article>
