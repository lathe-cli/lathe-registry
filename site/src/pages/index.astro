---
import SiteShell from "../layouts/SiteShell.astro";
import RecipeCard from "../components/RecipeCard.astro";
import { sitePath } from "../lib/paths";
import registry from "../data/registry.json";

const recipeCount = registry.recipes.length;
const sourceCount = registry.recipes.reduce((total, recipe) => total + recipe.source_refs.length, 0);
const skillCount = registry.recipes.filter((recipe) => recipe.skill_path).length;
---

<SiteShell title="Lathe Registry">
  <section class="registry-intro">
    <div>
      <h1>Lathe Registry</h1>
      <p>Reproducible Lathe CLI recipes with pinned sources, generated Skill bundles, build metadata, and exact inspection commands.</p>
    </div>
    <div class="registry-intro-actions">
      <div class="command-strip" aria-label="Registry command preview">
        <span>$</span>
        <code>lathe registry show daocloud-dce</code>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={sitePath("submit/")}>Submit recipe</a>
        <a class="button ghost" href="https://github.com/lathe-cli/lathe-registry">View source</a>
      </div>
    </div>
  </section>

  <section class="registry-summary" aria-label="Registry evidence summary">
    <div>
      <span>Recipes</span>
      <strong>{recipeCount} reproducible recipe live</strong>
    </div>
    <div>
      <span>Pinned sources</span>
      <strong>{sourceCount} upstream source refs tracked</strong>
    </div>
    <div>
      <span>Skill bundles</span>
      <strong>{skillCount} generated Skill ready</strong>
    </div>
  </section>

  <section class="toolbar" aria-label="Registry controls">
    <div class="registry-search">
      <span class="tab active">CLI Registry</span>
      <label>
        <span>Search</span>
        <input type="search" placeholder="Search CLIs, modules, auth..." data-registry-search />
      </label>
    </div>
    <div class="registry-count" data-registry-count>{recipeCount} recipe live</div>
  </section>

  <section class="registry-grid" aria-label="Available CLIs">
    {registry.recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
  </section>
</SiteShell>

<script>
  const input = document.querySelector("[data-registry-search]");
  const cards = Array.from(document.querySelectorAll("[data-recipe-card]"));
  const count = document.querySelector("[data-registry-count]");

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;

    for (const card of cards) {
      const matches = card.getAttribute("data-search-text")?.includes(query) ?? false;
      card.classList.toggle("hidden", !matches);
      if (matches) visible += 1;
    }

    if (count) {
      count.textContent = `${visible} recipe${visible === 1 ? "" : "s"} live`;
    }
  });
</script>
